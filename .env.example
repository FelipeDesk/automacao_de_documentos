# Referência: configure estas variáveis no terminal. Não há leitura automática de .env.
# Diretório dos dados operacionais do lote local; a API pública ignora.
# DADOS_DIR=C:/caminho/dados-notas
# Limites básicos da API pública, por processo (use também limites no proxy).
UPLOADS_POR_MINUTO=10
UPLOADS_SIMULTANEOS=2
# Tesseract deve estar no PATH ou definido abaixo.
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
OCR_LANG=por

# Processamento local por padrão. Não habilite envio sem autorização para os dados.
IA_HABILITADA=0
IA_ENVIO_AUTORIZADO=0
IA_ENVIO_IMAGEM=0
# Escolha gemini ou openai. Sem esta variável, o padrão é openai.
IA_PROVEDOR=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
# Gemini usa gemini-2.5-flash se IA_MODELO estiver vazio.
# Para OpenAI, defina um modelo compatível com Structured Outputs na Responses API.
IA_MODELO=
# Preços opcionais em USD por milhão de tokens, definidos conforme seu contrato/modelo.
IA_PRECO_ENTRADA_MILHAO=
IA_PRECO_SAIDA_MILHAO=
